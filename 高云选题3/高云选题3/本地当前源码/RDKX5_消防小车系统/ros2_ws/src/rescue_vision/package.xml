<?xml version="1.0"?>
<package format="3">
  <name>rescue_vision</name><version>0.1.0</version>
  <description>Stereo perception, LED traffic control, building OCR and UART integration.</description>
  <maintainer email="local@example.invalid">Rescue car project</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend><depend>rescue_interfaces</depend><depend>sensor_msgs</depend>
  <depend>std_msgs</depend><depend>cv_bridge</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-serial</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-libgpiod</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
